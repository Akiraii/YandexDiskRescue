<Window x:Class="YandexDiskRescue.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Yandex Disk Rescue — Completion" Width="1100" Height="820" MinWidth="780" MinHeight="600">
    <Grid Margin="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,18,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="YANDEX DISK RESCUE" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>
                <TextBlock Text="Токен Яндекс Полигона"/>
                <PasswordBox x:Name="TokenBox" PasswordChanged="TokenChanged"/>
                <TextBlock Text="Без согласия токен не сохраняется. Для работы после закрытия GUI разрешите защищённое хранение DPAPI." TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,16"/>
                <CheckBox x:Name="SaveTokenCheck" Foreground="White" Margin="0,8,0,12"><TextBlock Text="Разрешить фоновую работу (токен DPAPI)" TextWrapping="Wrap"/></CheckBox>
                <Button Content="Проверить подключение" Click="ConnectClick"/>
                <TextBlock x:Name="ConnectionStatus" Text="Не подключено" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,12,0,22"/>
                <TextBlock Text="Папка в облаке (пусто = весь Диск)" TextWrapping="Wrap"/>
                <TextBox x:Name="SourceBox" Text=""/>
                <Button Content="Посмотреть файлы" Click="ListClick"/>
                <TextBlock Text="Папка назначения на ПК" Margin="0,24,0,0"/>
                <TextBox x:Name="DestinationBox" Text=""/>
                <Button Content="Выбрать папку…" Click="BrowseClick"/>
                <TextBlock Text="Потоки передачи: 8" Margin="0,16,0,0"/>
                <Slider x:Name="TransfersSlider" Minimum="1" Maximum="32" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="TransfersChanged"/>
                <TextBlock Text="Лимит скорости (КиБ/с; 0 = без ограничения)" Margin="0,10,0,0"/>
                <TextBox x:Name="BandwidthBox" Text="0"/>
                <TextBlock Text="Отложенный запуск (локальное время, необязательно)"/>
                <DatePicker x:Name="ScheduleDate"/>
                <TextBox x:Name="ScheduleTime" Text="09:00" ToolTip="ЧЧ:мм"/>
                <CheckBox x:Name="RecurringDailyCheck" Content="Повторять ежедневное копирование" Foreground="White" Margin="0,6,0,10"/>
                <Border Background="#26354A" CornerRadius="8" Padding="12" Margin="0,15,0,12"><StackPanel>
                    <TextBlock Text="ФОТО ИЗ БЕЗЛИМИТА" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Сначала проверьте квоту и соберите список. Перенос в облаке — отдельное действие с подтверждением." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12"/>
                    <Button Content="Проверить квоту безлимита" Click="UnlimitedQuotaClick"/>
                    <TextBlock x:Name="UnlimitedQuotaStatus" Text="Квота не проверена" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12"/>
                    <TextBlock Text="Встроенный проверенный помощник yd.js"/>
                    <TextBox x:Name="UnlimitedScriptBox" IsReadOnly="True" ToolTip="Запускается только встроенный помощник с проверенной SHA256"/>
                    <TextBlock Text="Отдельный Chrome: сначала выполните вход в свой Яндекс Диск" TextWrapping="Wrap"/>
                    <Button Content="Открыть отдельный Chrome" Click="UnlimitedChromeClick"/>
                    <Button Content="Спасти фото: полный мастер" Click="UnlimitedRescueClick" FontWeight="Bold" Margin="0,10,0,12"/>
                    <Button Content="1. Собрать список (без изменений)" Click="UnlimitedListClick" Margin="0,6,0,0"/>
                    <Button Content="2. Перенести в обычную папку…" Click="UnlimitedMoveClick" Margin="0,6,0,0"/>
                    <Button Content="3. Проверить список и перенесённые файлы" Click="UnlimitedStateClick" Margin="0,6,0,0"/>
                    <Button Content="4. Скачать перенесённое и проверить" Click="UnlimitedDownloadClick" Margin="0,6,0,0"/>
                    <Button Content="Удалить отдельный профиль браузера (Chrome закрыт)" Click="UnlimitedClearProfileClick" Margin="0,6,0,0"/>
                    <TextBlock Text="Сохранённым считается только файл, проверенный после скачивания. При неполном списке, сбое или нехватке места мастер остановится." TextWrapping="Wrap" FontSize="12" Foreground="#FBBF24" Margin="0,10,0,0"/>
                </StackPanel></Border>
                <CheckBox x:Name="AutostartCheck" Content="Автозапуск копирования при входе в Windows" Checked="AutostartChanged" Unchecked="AutostartChanged" Foreground="White" Margin="0,10,0,10" />
                <Button Content="Удалить сохранённый токен" Click="DeleteTokenClick"/>
                <CheckBox x:Name="VerifyAfterCopy" Content="Проверить файлы после копирования" IsChecked="True" Foreground="White" Margin="0,14,0,0"/>
            </StackPanel></ScrollViewer>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Резервное копирование" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <Button x:Name="StartButton" Content="Добавить в очередь" Click="StartClick"/>
                <Button x:Name="CancelButton" Content="Остановить проверку" Click="CancelClick" IsEnabled="False"/>
                <Button Content="Пауза" Click="PauseJobClick"/>
                <Button Content="Отменить задание" Click="CancelJobClick"/>
                <Button Content="Продолжить" Click="ResumeClick"/>
                <Button Content="Проверить выбранное" Click="VerifySelectedClick"/>
                <Button Content="Отчёт" Click="OpenReportClick"/>
                <Button Content="Очистить вывод" Click="ClearClick"/>
            </WrapPanel>
            <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Очередь заданий (сохраняется на компьютере)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox x:Name="JobsList" Grid.Row="1" Background="#0B1220" Foreground="#E5E7EB"/>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="12" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="JobStatus" Text="Ожидание" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="1" x:Name="OutputBox" Background="#0B1220" Foreground="#D1D5DB" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
            <TextBlock Grid.Row="4" Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Text="Без телеметрии · Только rclone copy (без удаления) · Обычная проверка rclone check не заменяет полноценный аудит резервной копии"/>
        </Grid>
    </Grid>
</Window>
